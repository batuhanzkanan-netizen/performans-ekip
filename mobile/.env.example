# Expo Go önizlemesinde bunlar boş kalabilir. Gerçek uygulama derlemesi için doldur.
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_FUNCTIONS_REGION=europe-west1
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
# Native dosyalar: EAS file environment variables veya yerel dosya yolları.
GOOGLE_SERVICES_PLIST=./GoogleService-Info.plist
GOOGLE_SERVICES_JSON=./google-services.json
# Kesin uygulama kimlikleri Firebase kaydından önce belirlenir.
IOS_BUNDLE_IDENTIFIER=com.performansacademy.ekip
ANDROID_PACKAGE=com.performansacademy.ekip
